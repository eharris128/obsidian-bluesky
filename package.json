		"@wdio/cli": "9.27.2",
		"@wdio/local-runner": "9.27.2",
		"@wdio/mocha-framework": "9.27.2",
		"builtin-modules": "5.2.0",
		"esbuild": "0.28.0",
		"eslint": "10.4.1",
		"globals": "17.6.0",
		"mocha": "11.7.6",
		"obsidian": "1.13.0",
		"tslib": "2.8.1",
		"tsx": "4.22.4",
		"typescript": "6.0.3",
